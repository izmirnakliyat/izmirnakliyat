<!DOCTYPE html>
<html>
<head>
    <title>AJAX Form Test</title>
    <meta charset="UTF-8">
</head>
<body>
    <h2>AJAX Form Test - Canlı Site</h2>
    
    <form id="testForm">
        <input type="hidden" name="form_id" value="1">
        <input type="hidden" name="popup_form" value="1">
        
        <label>Ad: <input type="text" name="name" value="Test User" required></label><br><br>
        <label>Email: <input type="email" name="email" value="test@example.com" required></label><br><br>
        <label>Telefon: <input type="tel" name="phone" value="0555 123 45 67"></label><br><br>
        <label>Mesaj: <textarea name="message">Test mesajı</textarea></label><br><br>
        
        <button type="submit">AJAX ile Gönder</button>
    </form>
    
    <div id="result" style="margin-top: 20px; padding: 15px; border-radius: 5px;"></div>
    
    <script>
    document.getElementById('testForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const resultDiv = document.getElementById('result');
        
        resultDiv.innerHTML = '<p style="color: blue;">Gönderiliyor...</p>';
        
        // Test 1: process_form.php
        fetch('ajax/process_form.php', {
            method: 'POST',
            body: formData
        })
        .then(response => {
            console.log('Response status:', response.status);
            console.log('Response headers:', response.headers);
            return response.text(); // Önce text olarak al
        })
        .then(text => {
            console.log('Raw response:', text);
            
            try {
                const data = JSON.parse(text);
                console.log('Parsed JSON:', data);
                
                if (data.success) {
                    resultDiv.innerHTML = '<p style="color: green; background: #d4edda; padding: 10px;">✅ BAŞARILI: ' + data.message + '</p>';
                } else {
                    resultDiv.innerHTML = '<p style="color: red; background: #f8d7da; padding: 10px;">❌ HATA: ' + data.message + '</p>';
                }
            } catch (jsonError) {
                console.error('JSON Parse Error:', jsonError);
                resultDiv.innerHTML = '<p style="color: red; background: #f8d7da; padding: 10px;">❌ JSON HATA: ' + text + '</p>';
            }
        })
        .catch(error => {
            console.error('Fetch Error:', error);
            resultDiv.innerHTML = '<p style="color: red; background: #f8d7da; padding: 10px;">❌ NETWORK HATA: ' + error.message + '</p>';
        });
    });
    </script>
    
    <style>
    body { font-family: Arial, sans-serif; margin: 20px; line-height: 1.6; }
    form { background: #f9f9f9; padding: 20px; border-radius: 5px; }
    label { display: block; margin: 10px 0; }
    input, textarea { width: 300px; padding: 8px; border: 1px solid #ddd; border-radius: 3px; }
    button { padding: 10px 20px; background: #007cba; color: white; border: none; border-radius: 5px; cursor: pointer; }
    button:hover { background: #005a8b; }
    </style>
</body>
</html>
