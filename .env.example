# Canlı: proje kökünde ".env" olarak kopyalayın, doldurun. Repoya şifre commit etmeyin.
# Yerel XAMPP: .env şart değil (localhost’ta db.php sabitleri kullanılır).
# LAN IP (ör. 192.168.x.x) ile form debug / admin/debug_test açmak için:
# MYNAK_ALLOW_FORM_DEBUG=1

# admin/cron_auto_blog.php tarayıcıdan çağrılacaksa (önerilmez): güçlü rastgele değer + ?token=
# MYNAK_CRON_SECRET=

DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=
DB_PORT=3306

# İsteğe bağlı: boş bırakılırsa https://www.mynakliyat.com.tr kullanılır.
# Staging veya farklı domain için tam kanonik adres (sonunda / olmasın):
# SITE_URL=https://www.mynakliyat.com.tr

# Bakım: kökte .env ile canlı DB tanımlıyken — php scripts/smoke_check.php
# Yedek (CLI): php scripts/backup_database.php  —  isteğe bağlı mysqldump yolu:
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
